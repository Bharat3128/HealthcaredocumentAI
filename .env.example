ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

ConnectionStrings__DefaultConnection=Data Source=/app/data/healthcare.db

Ollama__BaseUrl=http://host.docker.internal:11434
Ollama__ChatModel=llama3.2:3b
Ollama__EmbeddingModel=nomic-embed-text
Ollama__TimeoutSeconds=120

Rag__MinimumScore=0.55
Rag__TopK=3

Chunking__ChunkSize=800
Chunking__Overlap=100

AzureStorage__Enabled=false
AzureStorage__ServiceUri=
AzureStorage__ContainerName=healthcare-documents

AzureStorage__Enabled=false
AzureStorage__ServiceUri=
AzureStorage__ContainerName=healthcare-documents

DocumentIntelligence__Enabled=false
DocumentIntelligence__Endpoint=
DocumentIntelligence__ModelId=prebuilt-read

AzureOpenAI__Enabled=false
AzureOpenAI__Endpoint=
AzureOpenAI__ChatDeployment=
AzureOpenAI__EmbeddingDeployment=
